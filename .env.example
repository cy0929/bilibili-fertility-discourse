# Copy to .env and fill in real values; .env is git-ignored — never commit it.
# You can also skip .env and export / setx these variables directly in your shell.

# Locally deployed OpenAI-compatible endpoint used for BOTH embeddings and sentiment analysis
# (vLLM / SGLang / LM Studio / Ollama). Comment text never leaves this machine unless you
# point this at a remote server yourself.
LLM_API_BASE_URL=http://localhost:8000/v1
# Bearer token; local servers usually accept anything. Leave empty to send the placeholder "EMPTY".
LLM_API_KEY=
# Optional: override the model name served by the endpoint (otherwise taken from the config files)
# LLM_MODEL=

# Data and output roots (optional; defaults are data / output)
BFD_DATA_ROOT=data
BFD_OUTPUT_ROOT=output

# BERTopic output directory (default for --input-dir in the boundary scripts)
BFD_TOPIC_OUTPUT_DIR=output/topic_classification

# Override config file paths (optional; by default the scripts look for a user
# config or the example template under config/)
# BFD_BERTOPIC_CONFIG=config/bertopic_config.yaml
# BFD_SENTIMENT_CONFIG=config/sentiment_config.toml
